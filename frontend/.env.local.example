# Copy to .env.local and fill in once the Firebase project exists (Milestone 0.4).
# These are client-side public config values (safe to expose in the browser) —
# NOT secrets. Real secrets (Anthropic key, service account keys) live only in
# the backend / Secret Manager, never here.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Milestone 5.5 -- a SEPARATE key from the backend's GOOGLE_MAPS_API_KEY
# (backend/.env.example). This one ships in the browser bundle, so it must
# be restricted differently: Google Cloud Console > APIs & Services >
# Credentials > Create Credentials > API Key, then on that key:
#   - Application restrictions: HTTP referrers (websites) -- add
#     http://localhost:3000/* for dev, plus your real domain later.
#   - API restrictions: restrict to "Maps JavaScript API" only.
# Also make sure "Maps JavaScript API" is enabled for the project (APIs &
# Services > Library) -- it's a separate API from Places/Geocoding/Routes/
# Weather, which M2.1 already enabled.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
