# Copy to .env for local development. Real values go in Google Secret Manager
# for staging/production (Milestone 9) — never commit a filled-in .env.

ENVIRONMENT=local
CORS_ALLOW_ORIGINS=http://localhost:3000

# From Firebase console > Project settings > General > Project ID
FIREBASE_PROJECT_ID=
# Path to the service account JSON you downloaded (Project settings > Service accounts >
# Generate new private key). Keep this file OUTSIDE the repo — never commit it.
GOOGLE_APPLICATION_CREDENTIALS=

# Populated in later milestones:
ANTHROPIC_API_KEY=
GOOGLE_MAPS_API_KEY=

# Milestone 8 — Google Calendar OAuth (from Cloud Console > APIs & Services >
# Credentials > OAuth client ID, type "Web application"). Separate from
# GOOGLE_MAPS_API_KEY -- this is an OAuth client, not an API key.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on that OAuth client.
# Local dev: http://localhost:8000/v1/calendar/oauth/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/v1/calendar/oauth/callback
