rules_version = '2';

// Every document under users/{userId} (preferences, saved places, search
// sessions, feedback, etc. — see design doc Step 6) is only readable/writable
// by that same authenticated user. The backend's Admin SDK calls bypass these
// rules entirely (service account credentials), so this only constrains any
// hypothetical direct client-to-Firestore access — belt-and-suspenders on top
// of the backend's own auth checks, not a replacement for them.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Shared, non-user-scoped API response cache — backend-only, never client-accessible.
    match /apiCache/{document=**} {
      allow read, write: if false;
    }

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
